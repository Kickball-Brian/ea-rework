# Email Agency — production Apache config for the React SPA build.
#
# This site is built as a static single-page app (React Router handles all
# in-app navigation client-side). Apache needs two things it doesn't do by
# default: fall back to prerendered/index HTML for any URL that isn't a real
# file on disk (so a direct visit or refresh on e.g. /contact-us doesn't
# 404), and 301 the handful of legacy WordPress URLs that had real content
# or real incoming links but no equivalent page in the rebuild.
#
# This replaces any previous WordPress .htaccess entirely — WordPress's own
# rewrite rules route everything through index.php, which no longer exists.

RewriteEngine On

# ── Legacy WordPress URLs with no equivalent route ──────────────────────────
# /solutions/ was a real hub page on the old site; the rebuild folds that
# into a section of the homepage instead of its own page. NE (noescape) is
# required here — without it Apache percent-encodes the # to %23, which
# browsers treat as a literal character in the path rather than a fragment,
# breaking the redirect (confirmed by testing against a local Apache
# instance before this shipped).
RewriteRule ^solutions/?$ /#ea-solutions [R=301,NE,L]

# /solutions/data-lists/ had real content, no matching solution in the
# rebuild — closest topical match.
RewriteRule ^solutions/data-lists/?$ /solutions/lead-generation [R=301,L]

# /mtmp/ (external Google Form short-link), /ntl-summit/ (broken stub on the
# old site, no real content), /articles/ (empty blog hub, zero posts).
RewriteRule ^mtmp/?$ / [R=301,L]
RewriteRule ^ntl-summit/?$ / [R=301,L]
RewriteRule ^articles/?$ / [R=301,L]

# /home was an early build's homepage route, superseded by / (the LabPage
# rebuild) and retired — 301 instead of a bare 404 in case it was ever
# indexed, bookmarked, or linked externally.
RewriteRule ^home/?$ / [R=301,L]

# /about-us was a standalone page duplicating the homepage's own #ea-about
# section (mission, values, team — same content, same TeamSection component)
# — retired in favor of that section, same as /solutions/ below. NE required
# for the same # -> %23 reason noted there.
RewriteRule ^about-us/?$ /#ea-about [R=301,NE,L]

# WordPress/Yoast default junk URLs — theme-builder taxonomy archives, the
# default post category, the default author archive, RSS endpoints. None of
# it is real content.
RewriteRule ^category/ / [R=301,L]
RewriteRule ^fusion_tb_category/ / [R=301,L]
RewriteRule ^element_category/ / [R=301,L]
RewriteRule ^author/ / [R=301,L]
RewriteRule ^feed/?$ / [R=301,L]
RewriteRule ^comments/feed/?$ / [R=301,L]

# ── SPA fallback, scoped to real routes ─────────────────────────────────────
# Only the actual routes from App.jsx get a fallback (so a direct visit or
# refresh on e.g. /contact-us doesn't 404). This used to be a blanket
# "anything that isn't a real file" rewrite to plain index.html, which meant
# a genuinely broken URL got served the SPA shell with an HTTP 200 —
# indistinguishable, to any crawler or tool that doesn't render JS, from a
# real page. Listing routes here instead means anything NOT in this list
# falls through to the real 404 below. / itself needs no entry —
# dist/index.html IS the prerendered homepage (see scripts/prerender.mjs),
# a real file Apache serves directly without hitting rewrite rules at all.
#
# These route to their own prerendered HTML (npm run build runs
# scripts/prerender.mjs after vite build, producing dist/prerendered/*)
# instead of the bare SPA shell — real content in the initial response for
# anything that doesn't execute JS (most SEO tools, social/link-preview
# bots, most AI/LLM crawlers), not just Google's own JS-rendering crawler.
# React still takes over and fully re-renders client-side once the JS
# bundle loads, exactly as before; this only changes what's in the raw HTML
# before that happens.
RewriteRule ^contact-us/?$ /prerendered/contact-us.html [L]
RewriteRule ^privacy-policy/?$ /prerendered/privacy-policy.html [L]
RewriteRule ^terms-conditions/?$ /prerendered/terms-conditions.html [L]
RewriteRule ^phoenix-rising-foundation/?$ /prerendered/phoenix-rising-foundation.html [L]

# /lab has no content of its own (client-side redirects straight to /), so
# it just needs the plain SPA shell to do that — nothing to prerender.
RewriteRule ^lab/?$ /index.html [L]

# One rule per solution, matching src/data/solutions.js — Apache can't read
# that file, so a new solution added there needs its slug added here too
# (and prerendered — scripts/prerender.mjs already reads SOLUTIONS
# directly, so only this list needs a manual update).
RewriteRule ^solutions/lead-generation/?$ /prerendered/solutions/lead-generation.html [L]
RewriteRule ^solutions/leadlogic/?$ /prerendered/solutions/leadlogic.html [L]
RewriteRule ^solutions/call-center-services/?$ /prerendered/solutions/call-center-services.html [L]
RewriteRule ^solutions/media-buys/?$ /prerendered/solutions/media-buys.html [L]
RewriteRule ^solutions/social-media-management/?$ /prerendered/solutions/social-media-management.html [L]
RewriteRule ^solutions/web-design/?$ /prerendered/solutions/web-design.html [L]

# Any OTHER /solutions/<slug> is a typo/unknown slug — SolutionDetailPage
# validates client-side and redirects back to /#ea-solutions rather than
# 404ing, so this still needs the plain SPA shell (no prerendered file
# exists for a slug that isn't real) rather than falling through to a 404.
RewriteRule ^solutions/[^/]+/?$ /index.html [L]

# ── Real 404s for everything else ───────────────────────────────────────────
# Anything not matched above (a typo, an old link, a bot probing random
# paths) hits Apache's normal file-not-found handling. ErrorDocument swaps
# in a real, prerendered NotFoundPage as the response body — NOT
# /index.html, which is now the prerendered *homepage* (overwritten by
# scripts/prerender.mjs) rather than a neutral shell; pointing 404s there
# would serve homepage content stamped with a 404 status, which is worse
# for a non-JS crawler than no prerendering at all. dist/404.html is
# prerendered separately for exactly this. Status stays 404, not 200.
ErrorDocument 404 /404.html

# ── Cache-Control headers ───────────────────────────────────────────────────
# Missing entirely before this — every asset was getting Apache's default
# caching behavior (effectively none), so repeat visitors re-fetched
# unchanged, content-hashed JS/CSS/images instead of getting instant cache
# hits. Same tuning already proven on the LawLogic/InsuranceLogic sibling
# projects: long-lived + immutable for Vite's content-hashed assets (a new
# build always ships new filenames, so there's no staleness risk), no-cache
# for HTML (including the prerendered pages and 404.html — the SPA entry
# point must always be fresh so a deploy is visible immediately).
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — short cache, always revalidate
  ExpiresByType text/html                  "access plus 0 seconds"

  # Versioned JS/CSS assets (Vite hashes filenames) — 1 year
  ExpiresByType application/javascript     "access plus 1 year"
  ExpiresByType text/css                   "access plus 1 year"

  # Images and fonts — 1 year
  ExpiresByType image/webp                 "access plus 1 year"
  ExpiresByType image/jpeg                 "access plus 1 year"
  ExpiresByType image/png                  "access plus 1 year"
  ExpiresByType image/svg+xml              "access plus 1 year"
  ExpiresByType font/ttf                   "access plus 1 year"
  ExpiresByType font/woff                  "access plus 1 year"
  ExpiresByType font/woff2                 "access plus 1 year"

  # Video — 1 month (hero scatter videos)
  ExpiresByType video/mp4                  "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # Versioned assets — immutable (Vite content-hashed filenames)
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images, fonts — long-lived
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ttf|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # Video — 1 month
  <FilesMatch "\.mp4$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML — no cache (SPA entry point, prerendered pages, and 404.html must
  # always be fresh so a new deploy is visible immediately)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
